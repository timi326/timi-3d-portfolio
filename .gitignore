/artifacts/

# ORBIT is an optional upstream integration. The upstream project currently
# has no declared software license, so its source and generated runtime are
# intentionally not redistributed by this repository.
/vendor/orbit-main/
/public/orbit-runtime/

# Local reference-furniture integration. The upstream repository declares
# itself UNLICENSED, so neither its derived geometry nor integration scripts
# are part of the public source release.
/public/reference-room/
/public/licenses/at010303-reference-provenance.txt
/app/reference-furniture.ts
/scripts/extract-reference-furniture.mjs
/scripts/extract-reference-extras.mjs
/scripts/inspect-reference-components.mjs
/scripts/inspect-reference-desk.py
/scripts/inspect-reference-swap.py
/scripts/render-reference-swap.py
/scripts/swap-reference-assets.py

# Keep only the runtime models used by the published site. Blender sources,
# comparison exports, and retired scene variants stay local.
/public/models/bruno/
/public/models/khronos/
/public/models/polyhaven/
/public/models/workspace/
/public/models/zsky/
/public/models/studio-room.gltf
/public/models/timi-desk.glb
/public/models/timi-sofa.glb
/public/models/timi-studio/*
!/public/models/timi-studio/sunset-editable-web.glb
!/public/models/timi-studio/sunset-colliders.json
